APP_NAME="Laravel Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
API_VERSION=1.0.0
ANALYTICS_REPORTING_TIMEZONE=Asia/Jakarta

# GitHub webhook secret for automatic deploys from pushes to main.
GITHUB_WEBHOOK_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel_starter
DB_USERNAME=postgres
DB_PASSWORD=

# ==============================================================================
# PASSPORT CLIENT CONFIGURATION (CRITICAL FOR AUTHENTICATION API)
# ==============================================================================
# You MUST generate a Password Grant Client by running:
#    php artisan passport:client --password
# Then copy the outputted Client ID and Client Secret below.
# Without this, login endpoint (/api/v1/auth/login) will fail.
# ==============================================================================
PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# local = store on disk (dev), public = publicly accessible local disk, s3 = S3-compatible object storage (prod)
FILESYSTEM_DISK=public
ASSET_UPLOAD_DISK=gcs
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=210

# Appraisal market-data processing. Production workers must consume queue triva.
APPRAISAL_MARKET_DATA_QUEUE=triva
APPRAISAL_MARKET_DATA_TIMEOUT=20
APPRAISAL_MARKET_DATA_USER_AGENT="TRIVA-MarketData/1.0 (authorized integration)"
APPRAISAL_MARKET_DATA_ALLOWED_HOSTS=www.olx.co.id,olx.co.id
APPRAISAL_MARKET_MIN_PRICE=20000000
APPRAISAL_MARKET_MAX_PRICE=10000000000
APPRAISAL_MARKET_MAX_AGE_DAYS=90
APPRAISAL_MARKET_MIN_SIMILARITY=0.55
APPRAISAL_MARKET_MIN_COMPARABLES=6
APPRAISAL_MARKET_HIGH_CONFIDENCE_COMPARABLES=12
APPRAISAL_MARKET_MAX_STABLE_DISPERSION=0.30
APPRAISAL_RESULT_VALID_DAYS=7
APPRAISAL_DEALER_MARGIN_PERCENT=7
APPRAISAL_PRICE_ROUNDING=500000

# Structured OpenAI price decision after OLX scraping cannot provide enough
# valid comparables. The backend still validates price bounds, applies trade-in
# adjustments deterministically, and stores an audit run without personal data.
APPRAISAL_AI_FALLBACK_ENABLED=true
APPRAISAL_AI_PRICE_DECISION_MODEL=gpt-5.6-sol
APPRAISAL_AI_RESEARCH_MODEL=gpt-5.6-sol
APPRAISAL_AI_REVIEW_MODEL=gpt-5.6-sol
APPRAISAL_AI_REASONING_EFFORT=low
APPRAISAL_AI_MAX_OUTPUT_TOKENS=6000
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_TIMEOUT_SECONDS=45
OPENAI_CONNECT_TIMEOUT_SECONDS=10

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_QUEUE_RETRY_AFTER=210
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3 / S3-compatible object storage (set FILESYSTEM_DISK=s3 for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Cloud Storage (disk 'gcs' — requires: composer require spatie/laravel-google-cloud-storage)
# Distribusi APK in-app (POST /api/v1/app/releases).
# Kosongkan untuk mematikan endpoint unggah sepenuhnya.
APP_RELEASE_UPLOAD_KEY=fM3BV5M7cAPngit1uy-_U_Clhk2GF1AgFl-HMINdvffyxJf0RD9-5MqAY9OdkMqf
APP_RELEASE_DISK=gcs
APP_RELEASE_MAX_KILOBYTES=204800

GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_KEY_FILE=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=
GOOGLE_CLOUD_STORAGE_API_URI=

# SMS provider for OTP (default: log driver — messages written to laravel.log)
# Swap LogSmsProvider for Twilio, Vonage, or local provider in AppServiceProvider
SMS_PROVIDER=log

# Firebase / FCM push notifications
# Leave blank to use the log driver (no real push sent — useful in dev/test)
FIREBASE_CREDENTIALS=
# FIREBASE_CREDENTIALS=/path/to/service-account.json

VITE_APP_NAME="${APP_NAME}"

# Set to true to include region data (~245k records) when running db:seed
# Run `php artisan regions:download` first, then `php artisan regions:seed`
SEED_REGIONS=false
